# Watchdog environment — EXAMPLE values only.
# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# ── Postgres ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=watchdog
DB_USER=watchdog
DB_PASSWORD=watchdog

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Spring profile ──
SPRING_PROFILES_ACTIVE=dev
